# Conexão com o PostgreSQL (ver infrastructure/docker/docker-compose.dev.yml)
DATABASE_URL="postgresql://relimpp:relimpp@localhost:5432/relimpp_connect?schema=public"

# Autenticação
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="1h"

# Servidor
PORT=3001
# Origem permitida para o frontend (CORS)
FRONTEND_ORIGIN="http://localhost:3000"

# Credenciais do usuário administrador criado pelo seed
SEED_ADMIN_EMAIL="admin@relimpp.local"
SEED_ADMIN_PASSWORD="Admin@123"
