// Relimpp Connect — schema inicial do Core Platform (MVP 0).
// Referências: docs/01-product-book/analise-inicio-desenvolvimento.md (seções 8 e 10)
// e ADR-0005 (estratégia multiempresa).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Estrutura organizacional (tenant = Company)
// ------------------------------------------------------------------

model Company {
  id        String   @id @default(uuid())
  name      String
  tradeName String?
  cnpj      String?  @unique
  active    Boolean  @default(true)

  branches         Branch[]
  departments      Department[]
  projects         Project[]
  costCenters      CostCenter[]
  users            User[]
  roleScopes       UserRoleScope[]
  purchaseRequests PurchaseRequest[]
  suppliers        Supplier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
  version   Int      @default(1)
}

model Branch {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseRequests PurchaseRequest[]

  @@index([companyId])
}

model Department {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseRequests PurchaseRequest[]

  @@index([companyId])
}

model Project {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseRequests PurchaseRequest[]

  @@index([companyId])
}

model CostCenter {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseRequests PurchaseRequest[]

  @@index([companyId])
}

// ------------------------------------------------------------------
// Usuários, papéis, permissões e escopo (RBAC — ADR-0006)
// ------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)

  roleScopes       UserRoleScope[]
  purchaseRequests PurchaseRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?
  permissions RolePermission[]
  roleScopes  UserRoleScope[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id        String           @id @default(uuid())
  key       String           @unique // ex.: "company:create"
  resource  String
  action    String
  roles     RolePermission[]
  createdAt DateTime         @default(now())
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// Vínculo papel + escopo organizacional de um usuário.
model UserRoleScope {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  companyId String?
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}

// ------------------------------------------------------------------
// Categorias configuráveis (base para módulos)
// ------------------------------------------------------------------

model Category {
  id        String   @id @default(uuid())
  type      String // ex.: "purchase", "supplier", "document"
  key       String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  purchaseRequests PurchaseRequest[]

  @@unique([type, key])
}

// ------------------------------------------------------------------
// Fornecedores — cadastro e homologação
// Status: PRE_REGISTERED, UNDER_REVIEW, APPROVED, RESTRICTED, SUSPENDED,
//         BLOCKED, INACTIVE (Especificação Funcional Consolidada, seção 10.1)
// ------------------------------------------------------------------

model Supplier {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  tradeName String?
  cnpj      String?
  email     String?
  phone     String?
  status    String  @default("PRE_REGISTERED")
  active    Boolean @default(true)

  events SupplierEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
  version   Int      @default(1)

  @@unique([companyId, cnpj])
  @@index([companyId])
  @@index([status])
}

model SupplierEvent {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type       String
  message    String
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([supplierId])
}

// ------------------------------------------------------------------
// Módulo de Compras — Solicitação de compra (MVP 1)
// Status: DRAFT, SUBMITTED, RETURNED, APPROVED, REJECTED, CANCELLED
// ------------------------------------------------------------------

model PurchaseRequest {
  id            String  @id @default(uuid())
  seq           Int     @default(autoincrement())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])
  requesterId   String
  requester     User    @relation(fields: [requesterId], references: [id])
  justification String
  priority      String  @default("medium") // low | medium | high | urgent
  status        String  @default("DRAFT")

  // Vínculo organizacional (Especificação, seção 8.1 "Identificação") — todos opcionais
  // e, quando informados, devem pertencer à mesma companyId (validado no service).
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id])
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  // Tipo/categoria (Especificação, seção 8.1 "Tipo") — Category com type = "purchase".
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Classificação (Especificação, seção 8.1 "Classificação"): priority já cobre urgência.
  criticality String? // low | medium | high
  confidential Boolean @default(false)

  items       PurchaseRequestItem[]
  events      PurchaseRequestEvent[]
  attachments PurchaseRequestAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
  version   Int      @default(1)

  @@index([companyId])
  @@index([status])
}

model PurchaseRequestItem {
  id             String          @id @default(uuid())
  requestId      String
  request        PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  description    String
  specification  String?
  quantity       Float           @default(1)
  unit           String          @default("un")
  estimatedPrice Float?
  // Especificação, seção 8.1 "Itens": data necessária e local de entrega são por item
  // (itens diferentes de uma mesma solicitação podem ter prazos/locais distintos).
  neededDate       DateTime?
  deliveryLocation String?

  @@index([requestId])
}

model PurchaseRequestEvent {
  id        String          @id @default(uuid())
  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type      String
  message   String
  actorId   String?
  createdAt DateTime        @default(now())

  @@index([requestId])
}

// Anexos (Especificação, seção 8.1 "Anexos"). Armazenamento em disco local por enquanto
// (ver infrastructure/local-db-windows para o mesmo espírito de "real, mas sem infra paga" —
// trocar por S3/blob storage é o passo natural antes de produção).
model PurchaseRequestAttachment {
  id          String          @id @default(uuid())
  requestId   String
  request     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  size        Int
  storagePath String // caminho relativo dentro de backend/uploads/
  uploadedBy  String?
  createdAt   DateTime        @default(now())

  @@index([requestId])
}
